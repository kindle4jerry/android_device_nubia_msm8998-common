# eBPF
# The 4.4 kernel has a backported 5.10-level eBPF implementation (see
# kernel/bpf: ringbuf, btf, trampoline, bpf_iter). Android's networking BPF
# stack reads this override instead of uname(2).
ro.bpf.kver_override=5.10.239

# Chipset
ro.soc.manufacturer=Qualcomm
ro.soc.model=MSM8998

# LMKD
ro.lmk.low=1001
ro.lmk.medium=800
ro.lmk.critical=0
ro.lmk.critical_upgrade=false
ro.lmk.upgrade_pressure=100
ro.lmk.downgrade_pressure=100
ro.lmk.kill_heaviest_task=true
ro.lmk.kill_timeout_ms=100
ro.lmk.use_psi=false
ro.lmk.use_minfree_levels=true

# Telephony
ro.telephony.handle_audio_direction_changes_between_call_state_changes=false
